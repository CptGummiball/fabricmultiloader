# Normalize line endings to LF in the repository; checkout is platform-dependent.
* text=auto eol=lf

# Reproducible builds: these files must be byte-exact LF.
*.java   text eol=lf
*.kt     text eol=lf
*.kts    text eol=lf
*.json   text eol=lf
*.toml   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.md     text eol=lf
*.properties text eol=lf
*.accesswidener text eol=lf
gradlew  text eol=lf
*.sh     text eol=lf

# Windows scripts need CRLF.
*.bat    text eol=crlf
gradlew.bat text eol=crlf

# Never touch binary files.
*.jar    binary
*.png    binary
*.ogg    binary
*.zip    binary
*.ico    binary

# Linguist: do not count documentation as a project language.
docs/** linguist-documentation
